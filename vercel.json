{
  "builds": [
    {
      "src": "api-functions/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api-functions/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}